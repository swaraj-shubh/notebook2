# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=notebook2

# At least 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma separated browser origins allowed to call the API (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional bootstrap admin (created on startup only if BOTH are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared public "global notebook" account (can edit notes, cannot upload files)
GUEST_EMAIL=unknown@unknown.com
GUEST_PASSWORD=123456

MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
ENABLE_DOCS=true
